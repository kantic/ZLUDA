.version 6.5
.target sm_30
.address_size 64

.visible .entry prefetch(
	.param .u64 input,
	.param .u64 output
)
{
	.reg .u64 	    in_addr;
	.reg .u64 	    out_addr;
	.reg .b64 	    global_addr;
	.reg .u64 	    temp;

	ld.param.u64 	in_addr, [input];
	ld.param.u64 	out_addr, [output];
	cvta.to.global.u64 	global_addr, in_addr;

	prefetch.global.L2 	[global_addr];
	prefetch.L1 	[in_addr];
	ld.u64          temp, [in_addr];
	st.u64          [out_addr], temp;
	ret;
}
